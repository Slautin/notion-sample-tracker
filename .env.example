APP_ENV=development
APP_SECRET_KEY=change-me
PUBLIC_BASE_URL=http://localhost:8000
NOTION_HOME_URL=https://www.notion.so/your-main-page
# Optional compatibility alias for older deployments:
# NOTION_PAGE=https://www.notion.so/your-main-page

NOTION_TOKEN=secret_xxx
NOTION_SAMPLES_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_RESULTS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_PEOPLE_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where archived files go: "onedrive" (default) or "local" (the disk of the machine running the app).
# The ONEDRIVE_* settings below are only needed for "onedrive".
STORAGE_BACKEND=onedrive

# OneDrive / SharePoint: UTK tenant only. Personal OneDrive is never used.
# Tenant ID of the UTK Entra ID directory (a GUID in production).
# common, consumers and organizations are rejected.
ONEDRIVE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ONEDRIVE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ONEDRIVE_CLIENT_SECRET=change-me
ONEDRIVE_AUTH_MODE=client_credentials
# Required. Drive ID of the UTK SharePoint document library (there is no /me/drive fallback).
ONEDRIVE_DRIVE_ID=b!xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional, comma-separated. If set, the drive's host must match, e.g.
# yourtenant.sharepoint.com,yourtenant-my.sharepoint.com
ONEDRIVE_ALLOWED_HOST_SUFFIXES=
ONEDRIVE_ROOT_FOLDER=SampleTracker

# Local development only. ONEDRIVE_AUTH_MODE=delegated_refresh is rejected when APP_ENV=production.
# It still needs ONEDRIVE_DRIVE_ID and a UTK tenant ID.
# ONEDRIVE_PUBLIC_CLIENT=false
# ONEDRIVE_REFRESH_TOKEN=required-only-for-delegated-refresh

# Local file storage (only with STORAGE_BACKEND=local). See "Local server storage" in the README.
# STORAGE_ROOT=./files
# STORAGE_MIN_FREE_MB=1024
# MAX_RESULT_FILE_MB=2048
# UPLOAD_CHUNK_MB=8
# UPLOAD_TTL_HOURS=24

# Access control. With STORAGE_BACKEND=local, production needs ONE of these:
# ACCESS_PASSWORD=a-long-shared-password   # HTTP Basic for the whole site (12+ chars, https only)
# ACCESS_USERNAME=lab
# ACCESS_BEHIND_AUTH_PROXY=true            # a login in front of the app protects every path, including /files/

BACKLOG_DIR=./backlog
ENABLE_BACKLOG_VIEW=false
BACKLOG_READ_LIMIT=50
MAX_UPLOAD_MB=200
MAX_UPLOAD_FILES=12
MAX_UPLOAD_FILE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.csv,.doc,.docx,.gif,.jpeg,.jpg,.json,.pdf,.png,.ppt,.pptx,.tif,.tiff,.txt,.webp,.xls,.xlsx,.zip
