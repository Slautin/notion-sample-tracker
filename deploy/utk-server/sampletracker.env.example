# /etc/sampletracker/sampletracker.env  (sudo chmod 600; owned by root; read by systemd, not by the app user)
# systemd reads this file as plain KEY=value lines: no quotes, no "export".

APP_ENV=production
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
# The address people use in the browser. Links stored in Notion are built from it, so pick the final
# hostname before you start and keep it stable.
PUBLIC_BASE_URL=https://sampletracker.example.utk.edu
NOTION_HOME_URL=https://www.notion.so/your-main-page

NOTION_TOKEN=secret_xxx
NOTION_SAMPLES_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_RESULTS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_PEOPLE_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

STORAGE_BACKEND=local
STORAGE_ROOT=/var/lib/sampletracker/files
BACKLOG_DIR=/var/lib/sampletracker/backlog
# Refuse uploads that would leave less than this much free disk.
STORAGE_MIN_FREE_MB=2048
MAX_RESULT_FILE_MB=2048

# Access control: set exactly one of these (production refuses to start with neither).
# 1) A login in front of the app (nginx SSO etc.) that protects every path including /files/:
ACCESS_BEHIND_AUTH_PROXY=true
# 2) or, until that login exists, a shared password for the whole site (12+ characters, https only):
# ACCESS_PASSWORD=
# ACCESS_USERNAME=lab

# Only nginx on this machine may reach the app.
GUNICORN_BIND=127.0.0.1:8000

# Lab data formats are not in the default list. Add what you need, e.g.:
# ALLOWED_UPLOAD_EXTENSIONS=.csv,.txt,.json,.xlsx,.pdf,.png,.jpg,.tif,.tiff,.zip,.ibw,.h5,.mat,.dm3,.dm4,.spm,.sxm
